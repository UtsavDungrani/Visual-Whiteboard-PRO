MONGO_URI=mongodb://127.0.0.1:27017/visual-whiteboard

# Required in production - the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: creates a single admin account on first boot if BOTH are set.
# Leave unset in production once the admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma separated list of origins allowed to call the API and sockets.
# Leave unset to accept any origin (development default).
# e.g. https://visual-whiteboard-pro.vercel.app
CORS_ORIGINS=
